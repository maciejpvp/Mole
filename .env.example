# Copy to .env on the production host. Never commit the populated .env file.
# docker-compose.prod.yml passes these values only to the control plane.
STRIPE_SECRET_KEY=sk_live_replace-with-live-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-live-webhook-signing-secret

# The frontend publishable key is not placed here: it is injected into the
# frontend image at build time by CI:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-live-publishable-key

# Other production values required by docker-compose.prod.yml.
BLUEPRINT_DB_DATABASE=mole
BLUEPRINT_DB_USERNAME=mole
BLUEPRINT_DB_PASSWORD=replace-with-a-strong-production-password
MOLE_SERVER_API_TOKEN=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=https://your-domain.example/api/v1/auth/google/callback
GOOGLE_FRONTEND_URL=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
