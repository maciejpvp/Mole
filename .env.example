# Copy to .env on the production host. Never commit the populated .env file.
# See DEPLOYMENT.md for the full deployment walkthrough.

# ------------------------------------------------------------------------------
# Deployment identity — set these first. Most other URLs are derived from
# MOLE_DOMAIN automatically, so you normally only set the domain once.
# ------------------------------------------------------------------------------
MOLE_DOMAIN=your-domain.example
CERTBOT_EMAIL=you@example.com

# Extra flags for certbot. Set to --staging while testing to avoid burning
# Let's Encrypt rate limits, then clear it. NOTE: switching from staging to
# production requires deleting the staging lineage first — see DEPLOYMENT.md.
CERTBOT_EXTRA_ARGS=

# Image tag produced by scripts/build-and-push.sh. Pin a real tag in production:
# with `latest`, `docker compose up -d` will not pull a newer image.
MOLE_IMAGE_TAG=latest

# Granted administrator permission at startup and on this account's next Google
# sign-in. Clear it once the first admin exists.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_replace-with-live-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-live-webhook-signing-secret

# The frontend publishable key is not placed here: it is injected into the
# frontend image at build time by scripts/build-and-push.sh, which reads it from
# the environment or from a gitignored .env.build:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-live-publishable-key

BLUEPRINT_DB_DATABASE=mole
BLUEPRINT_DB_USERNAME=mole
BLUEPRINT_DB_PASSWORD=replace-with-a-strong-production-password
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ------------------------------------------------------------------------------
# Derived from MOLE_DOMAIN — uncomment only to override.
# ------------------------------------------------------------------------------
# GOOGLE_REDIRECT_URL=https://your-domain.example/api/v1/auth/google/callback
# GOOGLE_FRONTEND_URL=https://your-domain.example
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# MOLE_PUBLIC_HOST=relay.example.com

# ------------------------------------------------------------------------------
# Embedded relay configuration. The control-plane container binds these listeners.
# ------------------------------------------------------------------------------
MOLE_CONTROL_PORT=9000

# Each port in this range is published on both TCP and UDP, so the default range
# costs 202 host port bindings (a docker-proxy process and iptables rules each).
# On a small instance prefer a narrower range, e.g. MOLE_TUNNEL_PORT_MAX=10020.
MOLE_TUNNEL_PORT_MIN=10000
MOLE_TUNNEL_PORT_MAX=10100

MOLE_GLOBAL_TRANSFER_LIMIT_BYTES=5497558138880

# ------------------------------------------------------------------------------
# Optional overrides. The values shown are the compose defaults.
# ------------------------------------------------------------------------------
# GOOGLE_COOKIE_SECURE=true
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=50
# AUTH_RATE_LIMIT_RPS=2
# AUTH_RATE_LIMIT_BURST=5
# BLOCKED_IPS=
# ALLOWED_IPS=
