PORT=8080

# Google OAuth credentials and redirect destinations.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
GOOGLE_COOKIE_SECURE=false

# Stripe server credentials for local development. Use sk_live_ and the live
# Dashboard webhook secret only in the production runtime environment.
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret

# PostgreSQL connection used by the control plane.
BLUEPRINT_DB_DATABASE=mole
BLUEPRINT_DB_USERNAME=mole
BLUEPRINT_DB_PASSWORD=replace-with-a-strong-password
BLUEPRINT_DB_HOST=127.0.0.1
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_SCHEMA=public

# Private management API of the relay. The token must match
# MOLE_SERVER_API_TOKEN in server/.env.
TUNNEL_SERVER_URL=http://relay-private-address:9001
TUNNEL_SERVER_API_TOKEN=replace-with-a-long-random-secret

# Security Configurations
# Comma-separated allowed CORS origins (do NOT use * with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.mole.com

# Global Rate Limiting (per client IP)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# Strict Auth Rate Limiting (for /api/v1/auth/*)
AUTH_RATE_LIMIT_RPS=2
AUTH_RATE_LIMIT_BURST=5

# IP Blacklisting and Whitelisting (comma-separated IPs or CIDRs e.g. 192.168.1.0/24)
BLOCKED_IPS=
ALLOWED_IPS=
