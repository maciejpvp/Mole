# Loaded automatically by Vite when running `vite build` (production mode).
# Empty string = same origin. All /api/... requests go to the nginx reverse proxy
# that serves this frontend, which in turn forwards them to the control plane.
VITE_CONTROL_PLANE_URL=
# CI supplies the live publishable key through the Docker build argument.
# Do not commit a real pk_live_ value here.
VITE_STRIPE_PUBLISHABLE_KEY=
